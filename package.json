{
  "name": "biopharma-tool",
  "version": "30.12.0",
  "private": true,
  "type": "module",
  "description": "Biopharma Production Integration Tool — tubing planner and autoclave load calculator",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/publish.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:offline": "node scripts/verify-offline.mjs",
    "check": "npm run test && npm run build && npm run verify:offline && npm run test:e2e",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
